# Google Drive Configuration
PIGEON_DRIVE_FOLDER=/Voice Recordings
PIGEON_POLL_INTERVAL=30
PIGEON_INBOX_DIR=../../dev_notes/inbox

# Google Authentication (profile-based like google-personal-mcp)
PIGEON_GOOGLE_PROFILE=default

# Slack Integration Configuration (optional)
# Bot token for Slack API authentication (starts with xoxb-)
PIGEON_SLACK_BOT_TOKEN=

# App-level token for Socket Mode connection (starts with xapp-)
PIGEON_SLACK_APP_TOKEN=

# Slack channel for inbox notifications
PIGEON_SLACK_INBOX_CHANNEL=

# Comma-separated list of Slack user IDs authorized to interact with Pigeon
PIGEON_SLACK_AUTHORIZED_USER_IDS=
